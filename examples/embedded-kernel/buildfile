# cudart carries the driver API headers and import library as well. It is
# imported through the lib{} group rather than libs{}, because cudart is
# static on Windows and libs{cudart} does not resolve.
#
import libs = cuda-cudart%lib{cudart}

# Used as real build tools below.
#
import nvcc  = cuda-nvcc%exe{nvcc}
import bin2c = cuda-nvcc%exe{bin2c}

./: exe{embedded-kernel}: {hxx ixx txx cxx}{**} hxx{kernel_fatbin} $libs

# Print the report rather than capture it: the examples are meant to be read.
#
exe{embedded-kernel}: test = true

# A .cu is not a cxx{} source. Keeping it out of the cxx target type is what
# leaves it to the recipe below.
#
define cu: file
cu{*}: extension = cu

# A handle for harvesting the transitive -I set of the imported libraries.
# $cxx.lib_poptions() is impure and may only be called in the depdb preamble.
#
libue{meta}: $libs

file{kernel.fatbin}: cu{kernel} libue{meta} $nvcc
{{
  lib_poptions = $cxx.lib_poptions(libue{meta}, obje)
  depdb hash $lib_poptions

  diag nvcc ($<[0]) -> $>

  # nvcc mishandles backslash paths on Windows.
  #
  poptions = $regex.apply($lib_poptions, '\\', '/')
  ccbin    = $regex.replace($effect($cxx.path), '\\', '/')

  # all-major rather than native, so the fatbin builds with no GPU present.
  # It holds one cubin per major architecture, and a cubin loads on any device
  # of the same major with an equal or higher minor. Embedding PTX instead
  # would need a driver at least as new as this nvcc to JIT it.
  #
  # The host compiler is the configured one rather than whatever is first on
  # PATH. nvcc rejects host compilers newer than it knows of, such as GCC 16.
  #
  $nvcc -x cu --fatbin -arch=all-major \
        -ccbin $ccbin -allow-unsupported-compiler \
        $poptions -o $path($>) $path($<[0])
}}

hxx{kernel_fatbin}: file{kernel.fatbin} $bin2c
{{
  diag bin2c ($<[0]) -> $>

  $bin2c --const --static --length --name kernel_fatbin $path($<[0]) >$path($>)
}}

cxx.poptions =+ "-I$out_root" "-I$src_root"
